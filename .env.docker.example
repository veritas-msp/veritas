# Copy to .env (or run scripts/prepare-docker-env), then:
#   docker compose up -d --build
#
# JWT_SECRET and ENCRYPTION_KEY must be non-empty (64 hex chars recommended).
# Leave them blank and run prepare-docker-env to generate them automatically.

POSTGRES_PASSWORD=changeme
JWT_SECRET=
ENCRYPTION_KEY=
VERITAS_EDITION=community

# Frontend Docker build heap (MB). Default 2048. Needs ~2 GB free RAM or swap.
# NODE_MAX_OLD_SPACE_SIZE=2048

# Optional: public URL when not using http://localhost:3000
# ALLOWED_ORIGINS=https://veritas.example.com
# FRONTEND_BASE_URL=https://veritas.example.com
