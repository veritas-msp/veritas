# Copy to .env, then: docker compose up -d --build
# JWT_SECRET / ENCRYPTION_KEY can stay empty — the backend generates them on first
# start (and the /setup wizard can set them).
#
# POSTGRES_PASSWORD is the Docker Postgres password. The setup wizard Database step
# uses it via DATABASE_URL (host=db, user=veritas, database=veritas).
# Default below is fine for first install — change it before production.

POSTGRES_PASSWORD=changeme
JWT_SECRET=
ENCRYPTION_KEY=
VERITAS_EDITION=community

# Optional: public URL when not using http://localhost:3000
# ALLOWED_ORIGINS=https://veritas.example.com
# FRONTEND_BASE_URL=https://veritas.example.com

# Pro license validation against Veritas Billing
# VERITAS_BILLING_API_URL=https://billing.veritas-msp.com
# VERITAS_BILLING_LICENSE_SECRET=

# Offline license lease HMAC secret — MUST match BILLING_LICENSE_LEASE_SECRET
# on veritas-billing. Generate: openssl rand -hex 32
VERITAS_LICENSE_LEASE_SECRET=

# Optional but recommended on Docker: keep the Pro key in the host .env so it
# survives rebuilds even before the first offline activation hydrates uploads/.boot-secrets
# VERITAS_LICENSE_KEY=VRT-PRO-XXXX-XXXX-XXXX-XXXX
# VERITAS_EDITION=pro

# Platform updates (Super Admin → account menu → Updates)
# Public GitHub Releases work without a token (rate-limited). A token raises limits.
# VERITAS_GITHUB_REPO=veritas-msp/veritas
# GITHUB_TOKEN=
# VERITAS_UPDATE_MODE=auto
# To APPLY updates from inside Docker, also mount /var/run/docker.sock on veritas-backend
# and set VERITAS_COMPOSE_FILE to the compose file path on the host if needed.
